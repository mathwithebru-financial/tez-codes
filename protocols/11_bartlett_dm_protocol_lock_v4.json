  "forecast_horizon_h": 1,
  "long_run_variance": {
    "estimator": "Bartlett kernel (Newey-West)",
    "max_lag_L": 19,
    "weights": "w_k = 1 - k/(L+1) = 1 - k/20, k=1..19",
    "formula": "omega = gamma_0 + 2*sum_{k=1}^{19} w_k*gamma_k; gamma_k=(1/n)*sum_{t=k+1}^{n}(d_t-dbar)(d_{t-k}-dbar)",
    "rationale": "L=19: 20-gunluk hareketli volatilite hedeflerindeki ortusmenin dogrudan isaret ettigi azami gecikme; seri bagimliligin 19. gecikmeden sonra sona erdigi varsayilmamaktadir"
  },
  "dm_statistic": "DM = dbar / sqrt(omega/n)",
  "hln_correction": {
    "h": 1,
    "factor": "c = sqrt((n+1-2h+h(h-1)/n)/n)",
    "note": "h=1 gercek tahmin ufku; ana analizle karsilastirilabilirlik icin korunmustur. Gecikme siniri tahmin ufkundan bagimsiz belirlenmistir."
  },
  "reference_distribution": "Student-t with n-1 df, two-sided",
  "multiple_comparison": {
