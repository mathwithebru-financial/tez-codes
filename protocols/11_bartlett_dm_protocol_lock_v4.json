  "loss": {
    "type": "pinball",
    "tau": 0.5,
    "formula": "rho(u)=max(tau*u,(tau-1)*u), u=y-yhat",
    "scale": "raw (original units)"
  },
  "loss_differential": {
    "definition": "d_t = L_baseline,t - L_final,t",
    "sign": "positive => final model lower loss"
